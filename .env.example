# Lifelogger Configuration
# Copy this file to .env and customize

# Database (TimescaleDB)
LIFELOGGER_DB_HOST=localhost
LIFELOGGER_DB_PORT=5432
LIFELOGGER_DB_NAME=lifelogger
LIFELOGGER_DB_USER=lifelogger
LIFELOGGER_DB_PASSWORD=changeme

# Ollama LLM
LIFELOGGER_OLLAMA_HOST=localhost
LIFELOGGER_OLLAMA_PORT=11434
LIFELOGGER_OLLAMA_MODEL=qwen2.5:7b

# Syncthing data paths
LIFELOGGER_SYNC_BASE_PATH=/home/user/Syncthing/lifelogger

# Notifications
LIFELOGGER_NTFY_SERVER=http://localhost:8080
LIFELOGGER_NTFY_TOPIC=lifelogger

# Notification channels (JSON array of Apprise URLs)
# See https://github.com/caronc/apprise for supported services
# Examples:
#   ntfy://localhost/topic
#   mailto://user:pass@smtp.gmail.com
#   tgram://bot_token/chat_id
#   slack://token/channel
LIFELOGGER_NOTIFICATION_CHANNELS=["ntfy://localhost/lifelogger"]

# Digest settings
LIFELOGGER_DIGEST_TIME_HOUR=7
LIFELOGGER_DIGEST_TIME_MINUTE=0
LIFELOGGER_DIGEST_TIMEZONE=UTC

# Data retention (days, -1 for unlimited)
LIFELOGGER_AUDIO_RETENTION_DAYS=30
LIFELOGGER_TRANSCRIPT_RETENTION_DAYS=365
LIFELOGGER_ACTIVITY_RETENTION_DAYS=365

# Device identification (for server)
LIFELOGGER_DEVICE_ID=server

# Logging
LIFELOGGER_LOG_LEVEL=INFO
