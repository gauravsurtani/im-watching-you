# Lifelogger Configuration
# Copy this file to .env and customize

# Database (TimescaleDB)
LIFELOGGER_DB_HOST=localhost
LIFELOGGER_DB_PORT=5432
LIFELOGGER_DB_NAME=lifelogger
LIFELOGGER_DB_USER=lifelogger
LIFELOGGER_DB_PASSWORD=changeme

# Ollama LLM (local - requires GPU or powerful CPU)
LIFELOGGER_OLLAMA_HOST=localhost
LIFELOGGER_OLLAMA_PORT=11434
LIFELOGGER_OLLAMA_MODEL=qwen2.5:7b

# OpenRouter (cloud LLM - has free tier!)
# Get your free API key at: https://openrouter.ai/keys
LIFELOGGER_OPENROUTER_API_KEY=
LIFELOGGER_OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
LIFELOGGER_OPENROUTER_FALLBACK_MODEL=google/gemma-2-9b-it:free
LIFELOGGER_OPENROUTER_RATE_LIMIT=20

# LLM Provider Strategy
# "local"          = Always use Ollama (maximum privacy, requires local GPU)
# "cloud"          = Always use OpenRouter (no GPU needed, uses free models)
# "hybrid"         = Smart routing: cloud for classification, local for sensitive data
# "cloud_fallback" = Try local first, fall back to cloud if local fails
LIFELOGGER_LLM_PROVIDER=hybrid

# Privacy settings for hybrid mode (when to force local processing)
LIFELOGGER_PRIVACY_LOCAL_TRANSCRIPTS=true
LIFELOGGER_PRIVACY_LOCAL_URLS=true
LIFELOGGER_PRIVACY_LOCAL_WINDOW_TITLES=false
LIFELOGGER_PRIVACY_LOCAL_DIGESTS=false

# Model Configuration (for task-specific model routing)
# Preset options: "speed", "balanced", "quality", "minimal"
LIFELOGGER_MODEL_PRESET=balanced

# Override specific models per task (optional - leave empty to use preset)
# Use OpenRouter model IDs like "meta-llama/llama-3.2-3b-instruct:free"
LIFELOGGER_MODEL_CLASSIFICATION=
LIFELOGGER_MODEL_ANALYSIS=
LIFELOGGER_MODEL_DIGEST=
LIFELOGGER_MODEL_GENERAL=

# Syncthing data paths
LIFELOGGER_SYNC_BASE_PATH=/home/user/Syncthing/lifelogger

# Notifications
LIFELOGGER_NTFY_SERVER=http://localhost:8080
LIFELOGGER_NTFY_TOPIC=lifelogger

# Notification channels (JSON array of Apprise URLs)
# See https://github.com/caronc/apprise for supported services
# Examples:
#   ntfy://localhost/topic
#   mailto://user:pass@smtp.gmail.com
#   tgram://bot_token/chat_id
#   slack://token/channel
LIFELOGGER_NOTIFICATION_CHANNELS=["ntfy://localhost/lifelogger"]

# Digest settings
LIFELOGGER_DIGEST_TIME_HOUR=7
LIFELOGGER_DIGEST_TIME_MINUTE=0
LIFELOGGER_DIGEST_TIMEZONE=UTC

# Data retention (days, -1 for unlimited)
LIFELOGGER_AUDIO_RETENTION_DAYS=30
LIFELOGGER_TRANSCRIPT_RETENTION_DAYS=365
LIFELOGGER_ACTIVITY_RETENTION_DAYS=365

# Device identification (for server)
LIFELOGGER_DEVICE_ID=server

# Logging
LIFELOGGER_LOG_LEVEL=INFO
