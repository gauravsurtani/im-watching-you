[Unit]
Description=Lifelogger Web Dashboard
Documentation=https://github.com/gauravsurtani/im-watching-you
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=lifelogger
Group=lifelogger
WorkingDirectory=/home/user/im-watching-you
EnvironmentFile=/home/user/im-watching-you/.env
ExecStart=/usr/bin/python -m uvicorn lifelogger.web.app:create_app --factory --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lifelogger-web

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
